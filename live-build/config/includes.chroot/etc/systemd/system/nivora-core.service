[Unit]
Description=Nivora Core local system intelligence service
After=local-fs.target
Before=graphical.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/nivora/core.py
Restart=on-failure
RestartSec=2
DynamicUser=yes
RuntimeDirectory=nivora
RuntimeDirectoryMode=0755
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
